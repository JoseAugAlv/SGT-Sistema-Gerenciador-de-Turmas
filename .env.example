APP_NAME=Prumo
; development = mostra os erros na tela (só no seu computador); production = página amigável e erros só no log (servidor)
APP_ENV=development
; Endereço completo do site (sem barra no final) e o caminho depois do domínio.
; Local: APP_URL=http://localhost/SGT e APP_BASE_PATH=/SGT
; Hospedado em subpasta: APP_URL=https://josealvesdev.com/projetos/prumo e APP_BASE_PATH=/projetos/prumo
APP_URL=http://localhost/SGT
APP_BASE_PATH=/SGT

DB_HOST=127.0.0.1
DB_NAME=sgt
DB_USER=root
DB_PASS=

; Email (SMTP). Porta 587 = TLS; porta 465 = SSL (o sistema escolhe sozinho).
; MAIL_FROM = endereço que aparece como remetente (se vazio, usa o MAIL_USER).
;   Gmail (até ~500/dia, pode cair no spam): smtp.gmail.com · 587 · seu email · senha de app
;   Hostinger (email do seu domínio):        smtp.hostinger.com · 465 · contato@seudominio.com · senha da caixa
;   Brevo (grátis, 300/dia, boa entrega):    smtp-relay.brevo.com · 587 · login SMTP do Brevo · chave SMTP · MAIL_FROM = email verificado no Brevo
;   Resend (grátis, 3.000/mês):              smtp.resend.com · 465 · resend · sua API key · MAIL_FROM = email do domínio verificado
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu-email@gmail.com
MAIL_PASS=sua-senha-app
MAIL_FROM=
MAIL_FROM_NAME=Prumo

; Login com Google: ID do cliente OAuth do Google Cloud Console
; URI de redirecionamento autorizado = APP_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

; Chave secreta do servidor (assina o QR de presença das reuniões). Gere com: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

; Mercado Pago (Pix real). Ligue em Comercial > "Ligar cobrança real" depois de preencher.
; Token: Mercado Pago > Suas integrações > Credenciais. Webhook: URL = APP_URL/webhooks/mercadopago (precisa de https), evento "Pagamentos".
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
