APP_NAME=Prumo
APP_ENV=development
; Endereço completo do site (sem barra no final) e o caminho depois do domínio.
; Local: APP_URL=http://localhost/SGT e APP_BASE_PATH=/SGT
; Hospedado em subpasta: APP_URL=https://josealvesdev.com/projetos/prumo e APP_BASE_PATH=/projetos/prumo
APP_URL=http://localhost/SGT
APP_BASE_PATH=/SGT

DB_HOST=127.0.0.1:3307
DB_NAME=RecycleWays
DB_USER=root
DB_PASS=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu-email@gmail.com
MAIL_PASS=sua-senha-app
MAIL_FROM_NAME=Prumo

APP_KEY=
; Login com Google: ID do cliente OAuth do Google Cloud Console
; URI de redirecionamento autorizado = APP_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

; Chave secreta do servidor (assina o QR de presença das reuniões). Gere com: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

; Mercado Pago (Pix real). Ligue em Comercial > "Ligar cobrança real" depois de preencher.
; Token: Mercado Pago > Suas integrações > Credenciais. Webhook: URL = APP_URL/webhooks/mercadopago (precisa de https), evento "Pagamentos".
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
